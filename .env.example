NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Páginas legales (/terminos y /privacidad): email de contacto, y "1" cuando las revise un abogado (oculta el aviso de borrador).
NEXT_PUBLIC_CONTACTO_EMAIL=
NEXT_PUBLIC_LEGAL_REVISADO=
# Avisos push (Web Push). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@pedi.app
# Service role de Supabase: SOLO en el servidor (Vercel), nunca con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con el Database Webhook de pedidos
PUSH_WEBHOOK_SECRET=
# Cron de reposición (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>"). Largo y aleatorio.
CRON_SECRET=
# WhatsApp de ayuda que se muestra en la portada y el login (solo dígitos, con código de país. Ej: 5491155555555). Vacío = no se muestra.
NEXT_PUBLIC_WHATSAPP_AYUDA=
# Mercado Pago: conectar con un clic (OAuth). Una sola aplicación para todos los locales. Pasos en docs/MP_OAUTH.md.
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=
# Clave secreta de los Webhooks de esa misma aplicación (firma todos los avisos de los locales conectados con un clic).
MP_WEBHOOK_SECRET=
# Dirección pública de la app (https://tu-dominio). Tiene que coincidir con el redirect cargado en Mercado Pago.
APP_URL=
# Demo en vivo (/demo): la cuenta que crea scripts/crear-demo.mjs. Solo en el servidor (Vercel), nunca con NEXT_PUBLIC_. Pasos en docs/DEMO.md.
DEMO_EMAIL=
DEMO_PASSWORD=
